# Ignore root node_modules and Next.js build cache
node_modules/
.next/
*.apk
*.aab
*.log

# Ignore mobile-app build caches and heavy folders
mobile-app/node_modules/
mobile-app/.expo/
mobile-app/dist/
mobile-app/web-build/
mobile-app/metro-cache/

# Ignore Android build output, native compilation caches, and Gradle caches
mobile-app/android/build
mobile-app/android/app/build
mobile-app/android/app/.cxx
mobile-app/android/.gradle
mobile-app/android/.kotlin
mobile-app/android/app/build/outputs/apk
mobile-app/android/app/build/outputs/bundle

# Ignore local logs
mobile-app/*.log
mobile-app/*.apk
mobile-app/*.aab
mobile-app/*.txt
mobile-app/convert.ps1
