import * as React from 'react';

declare module 'react' {
  interface Component<P = {}, S = {}, SS = any> {
    props?: any;
    context?: any;
    setState?: any;
    forceUpdate?: any;
    render?: any;
    refs?: any;
    state?: any;
  }
}

declare global {
  namespace JSX {
    interface ElementClass {
      props?: any;
    }
    interface ElementAttributesProperty {
      props: any;
    }
  }
  namespace React {
    namespace JSX {
      interface ElementClass {
        props?: any;
      }
      interface ElementAttributesProperty {
        props: any;
      }
    }
  }
}
